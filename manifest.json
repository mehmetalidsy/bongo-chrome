{
    "manifest_version": 3,
    "name": "Bongo Dev",
    "version": "1.0",
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["js/content.js"],
        "css": ["css/style.css"]
      }
    ],
    "action": {
      "default_popup": "popup.html"
    },
    "permissions": ["storage", "activeTab"],
    "web_accessible_resources": [
        {
          "resources": ["assets/*.png"],
          "matches": ["<all_urls>"]
        }
    ]
}